{
  "expo": {
    "name": "Kitchen Shelf",
    "slug": "recipe-organizer",
    "scheme": "kitchenshelf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "appleTeamId": "2GTT7CXQX9",
      "bundleIdentifier": "com.gtstewart16.recipeorganizer",
      "supportsTablet": true,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.gtstewart16.recipeorganizer"
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Kitchen Shelf uses the camera to capture cookbook recipes.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "5"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "expoPublicSupabaseUrl": "",
      "expoPublicSupabaseAnonKey": "",
      "expoPublicSupabaseImportFunctionUrl": "",
      "eas": {
        "projectId": "633f5d37-b6ee-4a9b-afe1-500824c1ed2e",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "KitchenShelfShare",
                  "bundleIdentifier": "com.gtstewart16.recipeorganizer.share",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.gtstewart16.recipeorganizer"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "plugins": [
      [
        "./plugins/with-ios-share-into-app",
        {
          "extensionBundleIdentifier": "com.gtstewart16.recipeorganizer.share"
        }
      ]
    ]
  }
}
